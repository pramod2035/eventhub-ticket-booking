{
    "info": {
      "name": "EventHub Ticket Booking API",
      "description": "API collection for EventHub full-stack assessment.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Auth",
        "item": [
          {
            "name": "Login User",
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": { "mode": "raw", "raw": "{\n    \"email\": \"admin@test.com\",\n    \"password\": \"password123\"\n}" },
              "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/auth/login", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "auth", "login"] }
            }
          }
        ]
      },
      {
        "name": "Admin",
        "item": [
          {
            "name": "Get All Events",
            "request": { "method": "GET", "header": [], "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/bookings/events", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "bookings", "events"] } }
          },
          {
            "name": "Create Event",
            "request": {
              "method": "POST",
              "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }, { "key": "Content-Type", "value": "application/json" }],
              "body": { "mode": "raw", "raw": "{\n    \"title\": \"Tech Summit 2026\",\n    \"date\": \"2026-08-20T10:00\",\n    \"location\": \"Auditorium A\",\n    \"ticketPrice\": 150000,\n    \"totalSeats\": 60\n}" },
              "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/admin/events", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "admin", "events"] }
            }
          },
          {
            "name": "Update Event",
            "request": {
              "method": "PUT",
              "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }, { "key": "Content-Type", "value": "application/json" }],
              "body": { "mode": "raw", "raw": "{\n    \"title\": \"Updated Summit\",\n    \"ticketPrice\": 200000,\n    \"totalSeats\": 100\n}" },
              "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/admin/events/EVENT_ID_HERE", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "admin", "events", "EVENT_ID_HERE"] }
            }
          },
          {
            "name": "Delete Event",
            "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }], "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/admin/events/EVENT_ID_HERE", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "admin", "events", "EVENT_ID_HERE"] } }
          },
          {
            "name": "Get All Bookings",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }], "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/admin/bookings", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "admin", "bookings"] } }
          },
          {
            "name": "Process Refund",
            "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }], "url": { "raw": "https://eventhub-ticket-booking.onrender.com/api/admin/refund/BOOKING_ID_HERE", "protocol": "https", "host": ["eventhub-ticket-booking", "onrender", "com"], "path": ["api", "admin", "refund", "BOOKING_ID_HERE"] } }
          }
        ]
      }
    ]
